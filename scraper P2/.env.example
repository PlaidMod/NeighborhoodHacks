# Copy to .env.local (never commit .env.local)
GEMINI_API_KEY=
# Model ids checked against @google/genai 2.30.0 (Oct 19, 2026). The newest pinned Flash id is used
# for extraction; no non-preview pinned Pro id is listed, so the fallback uses the Pro alias.
GEMINI_EXTRACT_MODEL=gemini-3.8-flash
GEMINI_EXTRACT_FALLBACK_MODEL=gemini-pro-latest
# Used by P3 only
GEMINI_JUDGE_MODEL=gemini-pro-latest
