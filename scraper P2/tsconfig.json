{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": ["lib/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "vitest.live.config.ts", "eslint.config.js"],
  "exclude": ["node_modules", "web", "tmp"]
}
