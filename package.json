{
  "name": "showup-htx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && npm run test:p4",
    "test:p4": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/p4/*.test.mjs",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "scrape": "tsx scripts/scrape.ts",
    "ingest": "tsx scripts/ingest.ts",
    "news": "tsx scripts/news.ts",
    "admin": "tsx scripts/admin-account.ts",
    "seed:bodies": "node --import tsx scripts/seed-bodies.ts",
    "seed:hcad-jurisdictions": "node --import tsx scripts/seed-hcad-jurisdictions.ts",
    "load:hcad": "node --import tsx scripts/load-hcad.ts",
    "stage:hcad": "node --import tsx scripts/stage-hcad.ts",
    "load:boundaries": "node --import tsx scripts/load-boundaries.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.59.0",
    "luxon": "^3.7.2",
    "motion": "13.5.1",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.0",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
