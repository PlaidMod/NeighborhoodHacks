# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Ask P5 for the shared values. Secrets are never posted in chat or the repo.

# --- Supabase (P5) ---
SUPABASE_URL=https://elsvhqqwdxwsuvkbchdq.supabase.co
# The project's secret key (sb_secret_...). Server-only: bypasses row level security.
# Supabase dashboard > Project Settings > API Keys > Secret keys.
SUPABASE_SERVICE_ROLE_KEY=
# Same URL plus the publishable key (sb_publishable_...), for admin sign-in (P5 Task 16).
NEXT_PUBLIC_SUPABASE_URL=https://elsvhqqwdxwsuvkbchdq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local only, for P1's bulk loads (ogr2ogr, COPY): the session-pooler connection string
# from Supabase dashboard -> Connect. Never set this on Vercel.
SUPABASE_DB_URL=

# --- Site (P5) ---
# Absolute base URL for links in texts and emails (P3). http://localhost:3000 locally.
SITE_URL=http://localhost:3000

# --- AI: OpenRouter (P2 extraction, P3 stories and news, P4 coach) ---
# The team's AI provider (decided Oct 20, 2026). Key from openrouter.ai/keys; ask the teammate who
# owns the account. Once it's set, every AI call goes through OpenRouter and GEMINI_API_KEY is ignored.
OPENROUTER_API_KEY=
# Models. The names keep their GEMINI_ prefix. A bare ID like gemini-3.8-flash is sent as
# google/gemini-3.8-flash; a full OpenRouter ID (vendor/model) is sent as is. Every model must
# support structured output (openrouter.ai/models, "structured outputs" filter).
# Default model for stories, the coach and news. Blank = gemini-3.8-flash.
GEMINI_MODEL=
# P2's extraction model, and the stronger model it retries with when more than 20% of an agenda's
# items fail checks (scraper spec D17). Blank = gemini-3.8-flash and gemini-4-argon.
GEMINI_EXTRACT_MODEL=
GEMINI_EXTRACT_FALLBACK_MODEL=
# P3's judge model for news coverage. P2 doesn't use it. Blank = GEMINI_MODEL.
GEMINI_JUDGE_MODEL=

# --- AI: Gemini direct (not used) ---
# Only a fallback for when OPENROUTER_API_KEY is blank. The team's .env.local and Vercel no longer set these
# (Oct 21, 2026); leave them blank. A Vertex AI key needs GOOGLE_GENAI_USE_VERTEXAI=true, an AI Studio key false.
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Speak up coach (P4) ---
# The request header that holds the visitor's IP, for the coach's per-IP limit. Set it to x-real-ip
# on Vercel, which overwrites that header so visitors can't fake it. Leave it blank locally: then
# every visitor shares one IP budget (20 coach calls an hour).
COACH_TRUSTED_IP_HEADER=

# --- Twilio text alerts (P3) ---
# From the Twilio console, once P3's registration is approved.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SID=

# --- Secrets generated by P5 ---
# Signs bodies_token links (P1 signs, P3 verifies).
BODIES_TOKEN_SECRET=
# Required by cron routes (P2 ingest, P3 alerts). Sent as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Scrambles IP addresses for rate limits (P1 lookup, P4 coach).
IP_HASH_SECRET=

# --- Admin (P2 review page) ---
# Comma-separated emails allowed into /admin. Each admin chooses their own password with
# npm run admin -- set-password <email>
ADMIN_EMAILS=

# --- Demo mode (P5) ---
# true = no Census, AI or Twilio calls; answers come from the demo cache.
DEMO_MODE=false
# true = save live answers into the demo cache while you click through the demo.
# Ignored on production deployments (Vercel sets VERCEL_ENV=production), so real visitors are never cached.
DEMO_RECORD=false
