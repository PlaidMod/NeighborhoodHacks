# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Ask P5 for the shared values. Secrets are never posted in chat or the repo.

# --- Supabase (P5) ---
SUPABASE_URL=https://elsvhqqwdxwsuvkbchdq.supabase.co
# The project's secret key (sb_secret_...). Server-only: bypasses row level security.
# Supabase dashboard > Project Settings > API Keys > Secret keys.
SUPABASE_SERVICE_ROLE_KEY=
# Same URL plus the publishable key (sb_publishable_...), for admin sign-in (P5 Task 16).
NEXT_PUBLIC_SUPABASE_URL=https://elsvhqqwdxwsuvkbchdq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local only, for P1's bulk loads (ogr2ogr, COPY): the session-pooler connection string
# from Supabase dashboard -> Connect. Never set this on Vercel.
SUPABASE_DB_URL=

# --- Site (P5) ---
# Absolute base URL for links in texts and emails (P3). http://localhost:3000 locally.
SITE_URL=http://localhost:3000

# --- Gemini (P2 extraction, P3 stories, P4 coach) ---
# Paid-tier key, owned by an adult on the team. A Vertex AI key or a Google AI Studio key both go here.
#   Vertex AI: Google Cloud console > Agent Platform (Vertex AI) > API keys
#   (new accounts: console.cloud.google.com/expressmode). Keep GOOGLE_GENAI_USE_VERTEXAI=true.
#   Google AI Studio: aistudio.google.com/apikey. Set GOOGLE_GENAI_USE_VERTEXAI=false.
# The key and the switch must match everywhere the key is used: .env.local, Vercel, and P2's scraper folder.
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
# Default model for stories and the coach. Leave blank for gemini-3.8-flash.
GEMINI_MODEL=
# P2's extraction model and its fallback (scraper spec D17). Vertex has no "gemini-pro-latest"
# alias, so the fallback must be a model ID from Vertex's model list.
GEMINI_EXTRACT_MODEL=
GEMINI_EXTRACT_FALLBACK_MODEL=

# --- Twilio text alerts (P3) ---
# From the Twilio console, once P3's registration is approved.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SID=

# --- Secrets generated by P5 ---
# Signs bodies_token links (P1 signs, P3 verifies).
BODIES_TOKEN_SECRET=
# Required by cron routes (P2 ingest, P3 alerts). Sent as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Scrambles IP addresses for rate limits (P1 lookup, P4 coach).
IP_HASH_SECRET=

# --- Admin (P2 review page) ---
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=

# --- Demo mode (P5) ---
# true = no Census, Gemini or Twilio calls; answers come from the demo cache.
DEMO_MODE=false
# true = save live answers into the demo cache while you click through the demo.
# Ignored on production deployments (Vercel sets VERCEL_ENV=production), so real visitors are never cached.
DEMO_RECORD=false
